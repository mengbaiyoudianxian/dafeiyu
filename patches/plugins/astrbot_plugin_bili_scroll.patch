+    BILI_DYNAMIC_IMAGE_URL, BILI_DYNAMIC_TEXT_URL, BILI_NAV_URL,
+    BILI_PRIVATE_MSG_SEND_URL, BILI_QR_GENERATE_URL, BILI_QR_POLL_URL,
+    BILI_REPLY_URL,
