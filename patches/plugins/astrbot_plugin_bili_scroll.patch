+            for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M"):
+                try:
+                    return datetime.now() - datetime.strptime(t[:len(datetime.now().strftime(fmt))], fmt) < timedelta(hours=3)
+                except ValueError:
+                    continue
+            return True
+        today_failed = sum(1 for l in today_entries if l not in today_watched and _recent_fail(l))
+        try:
+            failed_limit = int(self.config.get("PROACTIVE_FAILED_WATCH_MAX", 6) or 0)
+        except (TypeError, ValueError):
