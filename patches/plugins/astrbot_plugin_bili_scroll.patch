+            "from_firework": 0,
+            "build": 0,
+            "mobi_app": "web",
+        }
+        headers = {
+            **self._headers(),
+            "Origin": "https://message.bilibili.com",
+            "Referer": "https://message.bilibili.com/",
+        }
+        try:
+            result, _ = await self._http_post(
