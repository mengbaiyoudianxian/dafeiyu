+    @staticmethod
+    def _parse_fav_folders(raw):
+        """收藏夹配置解析：支持 media_id 数字，也支持带 fid=/media_id= 的分享链接。"""
+        ids = []
+        for item in raw or []:
+            text = str(item or "").strip()
+            if not text:
+                continue
+            if text.isdigit():
+                ids.append(text)
+                continue
+            match = re.search(r"(?:fid|media_id)=(\d+)", text)
+            if match:
+                ids.append(match.group(1))
+        ordered = []
+        for value in ids:
+            if value not in ordered:
+                ordered.append(value)
+        return ordered
