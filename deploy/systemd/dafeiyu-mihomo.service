[Unit]
Description=dafeiyu mihomo (QQ egress via home broadband)
After=network-online.target
[Service]
User=agentuser
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/mihomo -d /opt/dafeiyu/private/mihomo
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
